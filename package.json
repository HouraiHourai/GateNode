{
  "name": "gatenode",
  "version": "0.1.0",
  "description": "Deterministic code acceptance and bounded repair for pi-graph",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-extension",
    "pi-graph",
    "agent-graph",
    "code-validation",
    "bounded-repair"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "validate:examples": "tsx scripts/validate-examples.ts",
    "test:gate": "tsx --test --test-concurrency=1 test/gate*.test.ts",
    "demo": "tsx scripts/gate-demo.ts",
    "demo:prepare": "tsx scripts/gate-prepare.ts",
    "python:prepare": "tsx scripts/python-prepare.ts",
    "start": "pi --no-extensions --no-skills --no-prompt-templates -e ./extensions/pi-graph.ts",
    "demo:live": "tsx scripts/gate-live.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@earendil-works/pi-tui": "^0.83.0",
    "typebox": "^1.1.38"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-graph.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "exports": {
    "./runtime": "./src/index.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@types/node": "22.20.1",
    "tsx": "4.22.1",
    "typebox": "1.1.38",
    "typescript": "5.8.3"
  },
  "private": true
}
